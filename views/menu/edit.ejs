<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Edit menu</h1>

  <% if (errors.length) { %>
    <div class="pesan error">
      <ul>
        <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <%# _method di query string karena body multipart baru dibaca oleh multer %>
  <form action="/menu/<%= menu.id_menu %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <%- include('_form') %>

    <div class="form-group">
      <label>Gambar saat ini</label>
      <% if (menu.gambar) { %>
        <div><img src="/uploads/menu/<%= menu.gambar %>" alt="<%= menu.nama_menu %>" width="120"></div>
      <% } else { %>
        <p>Belum ada gambar.</p>
      <% } %>
    </div>

    <div class="form-group">
      <label for="gambar">Ganti gambar (kosongkan jika tidak ingin mengganti)</label>
      <input type="file" id="gambar" name="gambar" accept="image/png, image/jpeg">
    </div>

    <button type="submit" class="btn">Simpan perubahan</button>
    <a href="/menu" class="btn btn-batal">Kembali</a>
  </form>
</main>

<%- include('../partials/footer') %>