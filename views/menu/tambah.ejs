<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Tambah menu</h1>

  <% if (errors.length) { %>
    <div class="pesan error">
      <ul>
        <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/menu" method="POST" enctype="multipart/form-data">
    <%- include('_form') %>

    <div class="form-group">
      <label for="gambar">Gambar (JPG atau PNG, maksimal 2 MB)</label>
      <input type="file" id="gambar" name="gambar" accept="image/png, image/jpeg">
    </div>

    <button type="submit" class="btn">Simpan menu</button>
    <a href="/menu" class="btn btn-batal">Kembali</a>
  </form>
</main>

<%- include('../partials/footer') %>