<%# Field form bersama untuk tambah dan edit. Dipanggil dari tambah.ejs dan edit.ejs %>
<div class="form-group">
  <label for="nama_menu">Nama menu</label>
  <input type="text" id="nama_menu" name="nama_menu" value="<%= data.nama_menu || '' %>" required>
</div>

<div class="form-group">
  <label for="kategori_menu">Kategori</label>
  <select id="kategori_menu" name="kategori_menu" required>
    <option value="">Pilih kategori</option>
    <% kategoriList.forEach(function (k) { %>
      <option value="<%= k %>" <%= data.kategori_menu === k ? 'selected' : '' %>><%= k %></option>
    <% }) %>
  </select>
</div>

<div class="form-group">
  <label for="deskripsi_menu">Deskripsi</label>
  <textarea id="deskripsi_menu" name="deskripsi_menu" rows="3"><%= data.deskripsi_menu || '' %></textarea>
</div>

<div class="form-group">
  <label for="harga_menu">Harga (Rp)</label>
  <input type="number" id="harga_menu" name="harga_menu" min="1" step="any" value="<%= data.harga_menu || '' %>" required>
</div>

<div class="form-group">
  <label for="stok">Stok</label>
  <input type="number" id="stok" name="stok" min="0" step="1" value="<%= data.stok ?? 0 %>" required>
</div>