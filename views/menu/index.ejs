<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Daftar menu</h1>

  <% if (sukses) { %><div class="pesan sukses"><%= sukses %></div><% } %>
  <% if (error) { %><div class="pesan error"><%= error %></div><% } %>

  <form action="/menu" method="GET" class="filter-bar">
    <input type="text" name="q" placeholder="Cari nama menu" value="<%= filter.q %>">
    <select name="kategori">
      <option value="">Semua kategori</option>
      <% kategoriList.forEach(function (k) { %>
        <option value="<%= k %>" <%= filter.kategori === k ? 'selected' : '' %>><%= k %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn">Terapkan</button>
    <a href="/menu" class="btn btn-batal">Reset</a>
    <a href="/menu/tambah" class="btn">Tambah menu</a>
  </form>

  <% if (menu.length === 0) { %>
    <p>Belum ada menu yang cocok. Tambahkan menu baru atau ubah filter pencarian.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Gambar</th>
          <th>Nama</th>
          <th>Kategori</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% menu.forEach(function (m) { %>
          <tr>
            <td>
              <% if (m.gambar) { %>
                <img src="/uploads/menu/<%= m.gambar %>" alt="<%= m.nama_menu %>" width="70">
              <% } else { %>
                -
              <% } %>
            </td>
            <td>
              <strong><%= m.nama_menu %></strong>
              <% if (m.deskripsi_menu) { %><br><small><%= m.deskripsi_menu %></small><% } %>
            </td>
            <td><%= m.kategori_menu %></td>
            <td><%= formatRupiah(m.harga_menu) %></td>
            <td>
              <% if (m.stok === 0) { %>
                <span class="badge badge-habis">Habis</span>
              <% } else { %>
                <%= m.stok %>
              <% } %>
            </td>
            <td>
              <a href="/menu/<%= m.id_menu %>/edit" class="btn">Edit</a>
              <form action="/menu/<%= m.id_menu %>?_method=DELETE" method="POST" style="display:inline"
                    onsubmit="return confirm('Hapus menu ini?')">
                <button type="submit" class="btn btn-hapus">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>